  "standalone_beats": [],

  "tone_rules": [
    {
      "id": "multi_npc_social",
      "description": "每周至少产生2个涉及3人以上的多人社交场景，保持小镇的活力和信息流动",
      "applies_to": "weekly",
      "min_occurrence": 2
    },
    {
      "id": "night_tone",
      "description": "夜晚时段优先推进悬疑、阴暗或情感冲突剧情，避免纯日常。悬疑类事件权重在夜晚翻倍",
      "applies_to": "slot:night",
      "weight_modifier": 2.0
    },
    {
      "id": "morning_routine",
      "description": "早晨时段优先安排角色日常和职业活动（修网、诊所、学校），建立生活节奏感",
      "applies_to": "slot:morning"
    },
    {
      "id": "weekend_light",
      "description": "每周第6-7天可适当增加轻松日常，减少高风险事件（风险上限 Medium）",
      "applies_to": "day",
      "risk_cap": "Medium"
    },
    {
      "id": "no_info_dump",
      "description": "每个时段最多触发1个纯信息揭示类事件，避免连续灌输信息",
      "applies_to": "slot",
      "max_occurrence": 1
    }
  ],

  "global_constraints": {
    "max_events_per_slot": 3,
    "max_events_per_npc_per_day": 2,
    "anchor_priority_over_npc_intent": true
  }
}
