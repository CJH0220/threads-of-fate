{
  "version": "1.1",
  "description": "即兴日常事件模板。v1.1 扩展至10个模板，覆盖更多互动类型。",

  "templates": [
    {
      "id": "chance_encounter",
      "name": "偶遇",
      "min_participants": 2,
      "max_participants": 3,
      "requires_bond": true,
      "tone": "neutral",
      "delta_budget": {
        "bond": { "min": 0, "max": 2 },
        "happiness": { "min": 0, "max": 1 }
      },
      "pattern": "在 {location}，{name_a} 恰好遇到 {name_b}，{detail}。",
      "narrative_purpose": "维持小镇的人际网络感，让有缘线的 NPC 保持互动"
    },
    {
      "id": "idle_chat",
      "name": "闲聊",
      "min_participants": 2,
      "max_participants": 4,
      "requires_bond": false,
      "tone": "neutral",
      "delta_budget": {
        "bond": { "min": 0, "max": 1 },
        "happiness": { "min": 0, "max": 0 }
      },
      "pattern": "{location}里，{name_a} 和 {others} {detail}。",
      "narrative_purpose": "信息流动和气氛烘托，让小镇有生活气息"
    },
    {
      "id": "heated_debate",
      "name": "争论",
      "min_participants": 2,
      "max_participants": 3,
      "requires_bond": true,
      "tone": "tense",
      "delta_budget": {
        "bond": { "min": -4, "max": -1 },
        "happiness": { "min": -3, "max": -1 }
      },
      "pattern": "在 {location}，{name_a} 和 {name_b} 因为 {detail} 争执起来，气氛有些紧张。",
      "narrative_purpose": "制造中型戏剧张力，揭示角色间的深层矛盾"
    },
    {
      "id": "minor_conflict",
      "name": "小摩擦",
      "min_participants": 2,
      "max_participants": 2,
      "requires_bond": true,
      "tone": "tense",
      "delta_budget": {
        "bond": { "min": -3, "max": -1 },
        "happiness": { "min": -3, "max": -1 }
      },
      "pattern": "在 {location}，{name_a} 与 {name_b} 发生了口角——{detail}",
      "narrative_purpose": "制造小型戏剧张力，为后续关键事件铺垫情绪基础"
    },
    {
      "id": "mutual_help",
      "name": "互助",
      "min_participants": 2,
      "max_participants": 2,
      "requires_bond": true,
      "tone": "warm",
      "delta_budget": {
        "bond": { "min": 1, "max": 3 },
        "happiness": { "min": 1, "max": 2 }
      },
      "pattern": "{name_a} 在 {location} 遇到了困难，{name_b} 主动出手相助——{detail}",
      "narrative_purpose": "强化正向关系，提供温暖的叙事节拍平衡紧张感"
    },
    {
      "id": "share_secret",
      "name": "分享秘密",
      "min_participants": 2,
      "max_participants": 2,
      "requires_bond": true,
      "tone": "intimate",
      "delta_budget": {
        "bond": { "min": 2, "max": 5 },
        "happiness": { "min": -1, "max": 2 }
      },
      "pattern": "在 {location}，{name_a} 犹豫片刻后，向 {name_b} 说出了藏在心里的话——{detail}",
      "narrative_purpose": "推进角色弧线，揭示隐藏信息，深化角色关系"
    },
    {
      "id": "ask_for_help",
      "name": "求助",
      "min_participants": 2,
      "max_participants": 2,
      "requires_bond": false,
      "tone": "warm",
      "delta_budget": {
        "bond": { "min": 1, "max": 2 },
        "happiness": { "min": 0, "max": 1 }
      },
      "pattern": "{name_a} 犹豫再三，来到 {location} 找到 {name_b}，开口求助——{detail}",
      "narrative_purpose": "创造弱势角色的成长机会，建立跨阶层/跨年龄的纽带"
    },
    {
      "id": "shared_memory",
      "name": "回忆",
      "min_participants": 1,
      "max_participants": 3,
      "requires_bond": false,
      "tone": "warm",
      "delta_budget": {
        "bond": { "min": 0, "max": 2 },
        "happiness": { "min": -1, "max": 1 }
      },
      "pattern": "在 {location}，{name_a} {detail}——多年前的往事忽然涌上心头。",
      "narrative_purpose": "展现角色的内心世界和历史，让小镇有时间的纵深感"
    },
    {
      "id": "solitude_reflection",
      "name": "独处",
      "min_participants": 1,
      "max_participants": 1,
      "requires_bond": false,
      "tone": "neutral",
      "delta_budget": {
        "bond": { "min": 0, "max": 0 },
        "happiness": { "min": -1, "max": 1 }
      },
      "pattern": "{name_a} 独自在 {location}，{detail}",
      "narrative_purpose": "展现角色的内心世界，给高压力 NPC 喘息空间"
    },
    {
      "id": "discovery",
      "name": "发现线索",
      "min_participants": 1,
      "max_participants": 2,
      "requires_bond": false,
      "tone": "mysterious",
      "delta_budget": {
        "bond": { "min": 0, "max": 1 },
        "happiness": { "min": 0, "max": 0 }
      },
      "pattern": "在 {location}，{name_a} {detail}",
      "narrative_purpose": "推进调查线和悬疑氛围，为侦探线提供碎片线索"
    }
  ],

  "composition_rules": {
    "max_spontaneous_per_slot": 3,
    "no_same_template_consecutive": true,
    "forbidden_with_anchor": [],
    "night_allowed_only": ["solitude_reflection", "discovery", "minor_conflict", "share_secret", "shared_memory", "heated_debate", "ask_for_help"],
    "morning_preferred": ["idle_chat", "mutual_help", "solitude_reflection", "share_secret", "shared_memory", "chance_encounter", "ask_for_help"],
    "total_daily_bond_cap": 8,
    "total_daily_happiness_cap": 5
  }
}
